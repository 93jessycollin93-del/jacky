{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sas.cybernetic67.com/spec/1.0.0/pod.manifest.schema.json",
  "title": "SAS Superstation Pod Manifest",
  "description": "One station.pod.json per repo. See SPEC.md §8.",
  "type": "object",
  "required": ["kernel", "pod", "provides"],
  "properties": {
    "$schema": { "type": "string" },
    "kernel": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pod": {
      "type": "object",
      "required": ["id", "name", "role", "repo"],
      "properties": {
        "id": { "$ref": "capability.schema.json#/$defs/podId" },
        "name": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["engine", "surface", "vault", "bot", "knowledge"],
          "description": "Closed set. Maps onto repos.json tags: core->engine, condenser->knowledge, bot->bot, knowledge-source->knowledge."
        },
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "summary": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provides": {
      "type": "array",
      "items": { "$ref": "capability.schema.json" }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "capability.schema.json#/$defs/capabilityId" },
          "range": {
            "type": "string",
            "description": "Accepted payload-contract major, e.g. '1.x'. Absent means any.",
            "pattern": "^\\d+\\.(x|\\d+)$"
          },
          "optional": { "type": "boolean", "default": false }
        },
        "additionalProperties": true
      }
    },
    "surfaces": {
      "type": "array",
      "description": "How this pod is reachable. Informational - the contract defines no transport (SPEC.md §9).",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["http", "static", "edge-function", "cli", "embedded"] },
          "base": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
